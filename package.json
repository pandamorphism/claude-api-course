{
  "name": "claude-api-course",
  "version": "1.0.0",
  "description": "Anthropic Academy \"Building with the Claude API\" course, in Effect TS v4",
  "scripts": {
    "typecheck": "tsc -p .",
    "lesson": "tsx --env-file-if-exists=.env",
    "format": "prettier --write lessons src",
    "prepare": "effect-tsgo patch --typescript --no-oxlint && simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@effect/platform-node": "^4.1.0",
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
