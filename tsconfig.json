{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["@effect/platform-node/NodeRuntime#runMain"]
      }
    ]
  },
  "include": ["src", "lessons"]
}
